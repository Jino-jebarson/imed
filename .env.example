SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=admissions@imedacademy.in
PORT=3001

# Frontend API base used only in local development.
VITE_API_BASE_URL=http://localhost:3001

# In production, leave VITE_PROD_API_BASE_URL empty if /api is served from the same domain.
# If the API is on another domain, set VITE_PROD_API_BASE_URL to that HTTPS API origin,
# for example https://api.imedacademy.in
VITE_PROD_API_BASE_URL=

APP_BASE_URL=https://imedacademy.in
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/imed_crm?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_SETUP_CODE=replace-with-a-long-random-setup-code
CORS_ORIGINS=https://imedacademy.in,https://www.imedacademy.in

GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://imedacademy.in/api/admin/google-calendar/callback
GOOGLE_CALENDAR_TIME_ZONE=Asia/Kolkata
